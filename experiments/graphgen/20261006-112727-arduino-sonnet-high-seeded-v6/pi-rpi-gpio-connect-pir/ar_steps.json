   "step": 1,
   "say": "Put the board and the breadboard in front of you.",
   "add": [
    {
     "id": "pi",
     "type": "raspberry-pi-4-gpio",
     "label": "Raspberry Pi"
    }
   ]
  },
  {
   "step": 2,
   "add": [
    {
     "id": "pir1",
     "type": "pir-motion-sensor",
     "label": "PIR sensor",
     "props": {},
     "polarised": true,
     "legs": []
    }
   ]
  },
  {
   "step": 3,
   "power": false,
   "add": [
    {
     "id": "wire1",
