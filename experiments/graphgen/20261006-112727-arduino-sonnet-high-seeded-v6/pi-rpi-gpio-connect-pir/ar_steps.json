      {
       "part": "pi",
       "port": "2",
       "mm": [
        60.96,
        50.8
       ]
      }
     ]
    }
   ]
  },
  {
   "step": 4,
   "power": false,
   "add": [
    {
     "id": "wire2",
     "type": "jumper-wire",
     "colour": "black",
     "label": "GND jumper (female-to-female)",
     "ends": [
      {
       "part": "pi",
       "port": "6",
       "mm": [
        50.8,
        50.8
       ]
      }
     ]
    }
   ]
  },
  {
   "step": 5,
   "power": false,
   "add": [
    {
     "id": "wire3",
     "type": "jumper-wire",
     "colour": "orange",
     "label": "OUT to GPIO4 jumper (female-to-female)",
     "ends": [
      {
       "part": "pi",
       "port": "7",
       "mm": [
        48.26,
        50.8
       ]
      }
     ]
    }
   ]
  }
 ]
